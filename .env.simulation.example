# Ephemeral pipeline simulation — NOT production. Copied to .env.simulation by deploy/meetcon.sh simulate.
NODE_ENV=production

POSTGRES_DB=meetcon_sim
POSTGRES_USER=meetcon
POSTGRES_PASSWORD=sim-local-only-change-not-used-in-prod
DATABASE_URL=postgresql://meetcon:sim-local-only-change-not-used-in-prod@postgres:5432/meetcon_sim

REDIS_URL=redis://redis:6379

API_HOST=0.0.0.0
API_PORT=3001

GATEWAY_PUBLIC_PORT=30998
WEB_ORIGIN=https://127.0.0.1:30998

# Simulation-only secret (do not reuse in .env.production)
TOKEN_ENCRYPTION_KEY=ATIiEPlwoMeoCwY9R5H7h_De7q38Omv5W_BzxHeESfI

SESSION_COOKIE_NAME=meetcon_session_sim
SESSION_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=30

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MeetCon Sim <sim@localhost>

