NODE_ENV=development

POSTGRES_DB=meetcon
POSTGRES_USER=meetcon
POSTGRES_PASSWORD=meetcon
POSTGRES_PORT=5432
DATABASE_URL=postgresql://meetcon:meetcon@localhost:5432/meetcon

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=MeetCon <no-reply@meetcon.local>

API_PORT=3001
API_HOST=0.0.0.0
API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# Replace with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SESSION_COOKIE_NAME=meetcon_session
SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MEDIA_DIR=./data/media
MAX_IMAGE_BYTES=5000000
