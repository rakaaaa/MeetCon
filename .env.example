NODE_ENV=development

POSTGRES_DB=meetcon
POSTGRES_USER=meetcon
POSTGRES_PASSWORD=meetcon
POSTGRES_PORT=5432
DATABASE_URL=postgresql://meetcon:meetcon@localhost:5432/meetcon

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=MeetPlus <no-reply@meetcon.local>

# Digital Personal Data Protection notice. Defaults are used when these are unset.
DPDP_FIDUCIARY_NAME=MeetPlus
DPDP_GRIEVANCE_EMAIL=privacy@meetcon.local
DPDP_GRIEVANCE_POSTAL=

API_PORT=3001
API_HOST=0.0.0.0
API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# Replace with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SESSION_COOKIE_NAME=meetcon_session
SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MEDIA_DIR=./data/media
MAX_IMAGE_BYTES=5000000

# LinkedIn app → Auth → OAuth 2.0 settings.
# Redirect URL must be exactly: http://localhost:5173/api/auth/linkedin/callback
# Enable the product "Sign In with LinkedIn using OpenID Connect".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:5173/api/auth/linkedin/callback

# Optional OAuth clients for question drafting. The API starts without them.
# Redirect URLs: http://localhost:5173/api/auth/openai/callback
#                http://localhost:5173/api/auth/gemini/callback
#                http://localhost:5173/api/auth/anthropic/callback
# OPENAI_OAUTH_CLIENT_ID=
# OPENAI_OAUTH_CLIENT_SECRET=
# OPENAI_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/openai/callback
# GEMINI_OAUTH_CLIENT_ID=
# GEMINI_OAUTH_CLIENT_SECRET=
# GEMINI_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/gemini/callback
# ANTHROPIC_OAUTH_CLIENT_ID=
# ANTHROPIC_OAUTH_CLIENT_SECRET=
# ANTHROPIC_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/anthropic/callback
