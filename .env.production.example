# MeetPlus production environment (copy to .env.production on the VM).
# Never commit .env.production or real certificates.

NODE_ENV=production

POSTGRES_DB=meetcon
POSTGRES_USER=meetcon
# Use a URL-safe password (letters, numbers, hyphen, underscore) and put the same value in DATABASE_URL.
# Characters such as @ : / # ? must be percent-encoded inside DATABASE_URL.
POSTGRES_PASSWORD=change-me-use-openssl-rand-base64-24
DATABASE_URL=postgresql://meetcon:change-me-use-openssl-rand-base64-24@postgres:5432/meetcon

REDIS_URL=redis://redis:6379

API_HOST=0.0.0.0
API_PORT=3001

# VM / firewall: expose this TCP port on the host (maps to gateway HTTPS in docker-compose.prod.yml).
GATEWAY_PUBLIC_PORT=30098

# Public site URL — must include GATEWAY_PUBLIC_PORT (cookies, CORS, emails, QR links).
WEB_ORIGIN=https://meetcon.aiadoptionecosystem.com:30098

# Token encryption is derived from POSTGRES_PASSWORD in the API (no separate key).

SESSION_COOKIE_NAME=meetcon_session
SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30

SMTP_HOST=smtp.aiadoptionecosystem.com
# Port 587 is STARTTLS, so SMTP_SECURE stays false.
# Use SMTP_SECURE=true only for implicit TLS, usually port 465.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=meetcon-mailer@aiadoptionecosystem.com
SMTP_PASSWORD=change-me
MAIL_FROM=MeetPlus <no-reply@aiadoptionecosystem.com>

# Shown on the privacy notice and in Settings. Use the legal entity and grievance contact.
DPDP_FIDUCIARY_NAME=MeetPlus
DPDP_GRIEVANCE_EMAIL=privacy@aiadoptionecosystem.com
DPDP_GRIEVANCE_POSTAL=

MEDIA_DIR=/data/media
MAX_IMAGE_BYTES=5000000

# Redirect URL: ${WEB_ORIGIN}/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional OAuth clients. Redirect URLs use ${WEB_ORIGIN}/api/auth/openai|gemini|anthropic/callback
# OPENAI_OAUTH_CLIENT_ID=
# OPENAI_OAUTH_CLIENT_SECRET=
# GEMINI_OAUTH_CLIENT_ID=
# GEMINI_OAUTH_CLIENT_SECRET=
# ANTHROPIC_OAUTH_CLIENT_ID=
# ANTHROPIC_OAUTH_CLIENT_SECRET=
